{
  "name": "hop-viec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "export:html": "npm run build && node scripts/export-html.mjs",
    "test:html": "node scripts/check-html.mjs",
    "publish:html": "node scripts/publish-html.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  }
}
