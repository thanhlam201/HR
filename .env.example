# No credentials needed for local development: SQLite at .data/hopviec.sqlite.
# For Vercel, use a persistent PostgreSQL database (e.g. Supabase).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Require TLS certificate verification on a production database.
# PG_TLS=true
# Set to false to omit illustrative jobs from a fresh production database.
SEED_DEMO=true
